	}

	for projectKey, emails := range assignments {
		project := projects[projectKey]
		for _, email := range emails {
			user := users[email]
			role := "member"
			if user.ID == ownerID {
				role = "admin"
			}
			record := projectMember{
				ProjectID:       project.ID,
