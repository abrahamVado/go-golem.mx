package seeders

import (
	"errors"
	"strings"

	companiesmod "github.com/abrahamVado/go-golem.mx/internal/modules/companies"
	permissionsmod "github.com/abrahamVado/go-golem.mx/internal/modules/permissions"
	rolesmod "github.com/abrahamVado/go-golem.mx/internal/modules/roles"
	rbacmod "github.com/abrahamVado/go-golem.mx/internal/modules/rbac"
	usersmod "github.com/abrahamVado/go-golem.mx/internal/modules/users"
	"github.com/abrahamVado/go-golem.mx/internal/platform/config"
	"github.com/abrahamVado/go-golem.mx/internal/security"
	"github.com/google/uuid"
	"gorm.io/gorm"
)

func Run(db *gorm.DB, cfg config.Config) error {
	email := strings.ToLower(strings.TrimSpace(cfg.DefaultOwnerEmail))
	password := cfg.DefaultOwnerPassword
	companyName := strings.TrimSpace(cfg.DefaultCompanyName)

	if email == "" || password == "" {
		return nil
	}

	return db.Transaction(func(tx *gorm.DB) error {
		company := companiesmod.Company{
			Name:   companyName,
			Slug:   slugify(companyName),
			Status: "active",
		}

		if err := tx.Where("slug = ?", company.Slug).FirstOrCreate(&company).Error; err != nil {
			return err
		}

		hash, err := security.HashPassword(password, cfg.BcryptCost)
		if err != nil {
			return err
		}

		var user usersmod.User
		err = tx.Where("email = ?", email).First(&user).Error
		if err == nil {
			if err := tx.Model(&user).Updates(map[string]any{
				"company_id":    company.ID,
				"name":          "Platform Admin",
				"password_hash": hash,
				"status":        "active",
			}).Error; err != nil {
				return err
			}
			return ensureOwnerAccess(tx, company.ID, user.ID)
		}

		if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
			return err
		}

		user = usersmod.User{
			CompanyID:    company.ID,
			Email:        email,
			Name:         "Platform Admin",
			PasswordHash: hash,
			Status:       "active",
		}

		if err := tx.Create(&user).Error; err != nil {
			return err
		}

		return ensureOwnerAccess(tx, company.ID, user.ID)
	})
}

type userRole struct {
	UserID    uuid.UUID  `gorm:"column:user_id"`
	CompanyID uuid.UUID  `gorm:"column:company_id"`
	RoleID    uuid.UUID  `gorm:"column:role_id"`
	DeletedAt *string    `gorm:"column:deleted_at"`
}

func (userRole) TableName() string { return "user_roles" }

func ensureOwnerAccess(tx *gorm.DB, companyID, userID uuid.UUID) error {
	if err := ensureRBACSchema(tx); err != nil {
		return err
	}

	permissions := []permissionsmod.Permission{
		{Name: "users.read", Description: "Read users"},
		{Name: "users.create", Description: "Create users"},
		{Name: "users.update", Description: "Update users"},
		{Name: "users.delete", Description: "Delete users"},
		{Name: "roles.read", Description: "Read roles"},
		{Name: "roles.create", Description: "Create roles"},
		{Name: "roles.update", Description: "Update roles"},
		{Name: "roles.delete", Description: "Delete roles"},
		{Name: "companies.read", Description: "Read company settings"},
		{Name: "companies.update", Description: "Update company settings"},
	}

	for _, permission := range permissions {
		if err := tx.
			Where("name = ?", permission.Name).
			Assign(map[string]any{"description": permission.Description}).
			FirstOrCreate(&permission).Error; err != nil {
			return err
		}
	}

	role := rolesmod.Role{
		CompanyID:   &companyID,
		Name:        rbacmod.SystemRoleOwner,
		Description: "Full access to all company modules",
		IsSystem:    true,
	}
	if err := tx.
		Where("company_id = ? AND name = ?", companyID, role.Name).
		Assign(map[string]any{
			"description": role.Description,
			"is_system":   true,
		}).
		FirstOrCreate(&role).Error; err != nil {
		return err
	}

	if err := tx.Exec(`
		INSERT INTO role_permissions (role_id, permission_id)
		SELECT ?, p.id
		FROM permissions p
		ON CONFLICT (role_id, permission_id) DO NOTHING
	`, role.ID).Error; err != nil {
		return err
	}

	return tx.Exec(`
		INSERT INTO user_roles (user_id, company_id, role_id, deleted_at)
		VALUES (?, ?, ?, NULL)
		ON CONFLICT (user_id, company_id, role_id)
		DO UPDATE SET deleted_at = NULL
	`, userID, companyID, role.ID).Error
}

func ensureRBACSchema(tx *gorm.DB) error {
	statements := []string{
		`CREATE TABLE IF NOT EXISTS permissions (
			id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
			name TEXT NOT NULL UNIQUE,
			description TEXT NOT NULL DEFAULT '',
			created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
			updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
		)`,
		`CREATE TABLE IF NOT EXISTS roles (
			id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
			company_id UUID NULL REFERENCES companies(id) ON DELETE CASCADE,
			name TEXT NOT NULL,
			description TEXT NOT NULL DEFAULT '',
			is_system BOOLEAN NOT NULL DEFAULT FALSE,
			created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
			updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
			deleted_at TIMESTAMPTZ NULL
		)`,
		`CREATE UNIQUE INDEX IF NOT EXISTS uq_roles_company_name ON roles(company_id, name)`,
		`CREATE INDEX IF NOT EXISTS idx_roles_deleted_at ON roles(deleted_at)`,
		`CREATE TABLE IF NOT EXISTS role_permissions (
			role_id UUID NOT NULL REFERENCES roles(id) ON DELETE CASCADE,
			permission_id UUID NOT NULL REFERENCES permissions(id) ON DELETE CASCADE,
			created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
			PRIMARY KEY (role_id, permission_id)
		)`,
		`CREATE TABLE IF NOT EXISTS user_roles (
			user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
			company_id UUID NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
			role_id UUID NOT NULL REFERENCES roles(id) ON DELETE CASCADE,
			created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
			deleted_at TIMESTAMPTZ NULL,
			PRIMARY KEY (user_id, company_id, role_id)
		)`,
	}

	for _, statement := range statements {
		if err := tx.Exec(statement).Error; err != nil {
			return err
		}
	}

	return nil
}

func slugify(value string) string {
	value = strings.ToLower(strings.TrimSpace(value))
	value = strings.ReplaceAll(value, "_", "-")

	var b strings.Builder
	lastDash := false

	for _, r := range value {
		switch {
		case r >= 'a' && r <= 'z', r >= '0' && r <= '9':
			b.WriteRune(r)
			lastDash = false
		case r == ' ' || r == '-':
			if !lastDash && b.Len() > 0 {
				b.WriteByte('-')
				lastDash = true
			}
		}
	}

	slug := strings.Trim(b.String(), "-")
	if slug == "" {
		return "demo-company"
	}

	return slug
}
