package permissions

import (
	"errors"

	"github.com/abrahamVado/go-golem.mx/internal/response"
	"github.com/abrahamVado/go-golem.mx/internal/tenancy"
	"github.com/gin-gonic/gin"
)

type Handler struct{ svc *Service }

func NewHandler(s *Service) *Handler { return &Handler{svc: s} }
func (h *Handler) List(c *gin.Context) {
	items, err := h.svc.List()
	if err != nil {
		response.Internal(c, "Failed to load permissions")
		return
	}
	response.OK(c, gin.H{"company_id": tenancy.CompanyID(c), "module": "permissions", "items": items})
}
func (h *Handler) Get(c *gin.Context) {
	response.OK(c, gin.H{"id": c.Param("id"), "module": "permissions"})
}
func (h *Handler) Create(c *gin.Context) {
	var req CreateRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		response.BadRequest(c, "Invalid permission payload")
		return
	}

	item, err := h.svc.Create(req)
	if err != nil {
		switch {
		case errors.Is(err, ErrPermissionNameRequired):
			response.BadRequest(c, err.Error())
		case errors.Is(err, ErrPermissionNameExists):
			response.Conflict(c, err.Error())
		default:
			response.Internal(c, "Failed to create permission")
		}
		return
	}

	response.Created(c, item)
}
func (h *Handler) Update(c *gin.Context) {
	response.OK(c, gin.H{"id": c.Param("id"), "module": "permissions", "status": "updated"})
}
func (h *Handler) Delete(c *gin.Context) {
	response.OK(c, gin.H{"id": c.Param("id"), "module": "permissions", "status": "deleted"})
}
