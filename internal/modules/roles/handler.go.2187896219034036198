package roles

import (
	"errors"

	"github.com/abrahamVado/go-golem.mx/internal/response"
	"github.com/abrahamVado/go-golem.mx/internal/tenancy"
	"github.com/google/uuid"
	"github.com/gin-gonic/gin"
)

type Handler struct{ svc *Service }

func NewHandler(s *Service) *Handler { return &Handler{svc: s} }
func (h *Handler) List(c *gin.Context) {
	items, err := h.svc.List(tenancy.CompanyID(c))
	if err != nil {
		response.Internal(c, "Failed to load roles")
		return
	}
	response.OK(c, gin.H{"company_id": tenancy.CompanyID(c), "module": "roles", "items": items})
}
func (h *Handler) Get(c *gin.Context) { response.OK(c, gin.H{"id": c.Param("id"), "module": "roles"}) }
func (h *Handler) Create(c *gin.Context) {
	var req CreateRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		response.BadRequest(c, "Invalid role payload")
		return
	}

	role, err := h.svc.Create(tenancy.CompanyID(c), req)
	if err != nil {
		switch {
		case errors.Is(err, ErrRoleNameRequired), errors.Is(err, ErrRolePermissionInvalid):
			response.BadRequest(c, err.Error())
		case errors.Is(err, ErrRoleNameExists):
			response.Conflict(c, err.Error())
		default:
			response.Internal(c, "Failed to create role")
		}
		return
	}

	response.Created(c, role)
}
func (h *Handler) GetPermissions(c *gin.Context) {
	roleID, err := uuid.Parse(c.Param("id"))
	if err != nil {
		response.BadRequest(c, "Invalid role id")
		return
	}

	items, err := h.svc.ListPermissions(tenancy.CompanyID(c), roleID)
	if err != nil {
		switch {
		case errors.Is(err, ErrRoleNotFound):
			response.NotFound(c, err.Error())
		default:
			response.Internal(c, "Failed to load role permissions")
		}
		return
	}

	response.OK(c, gin.H{"id": c.Param("id"), "module": "roles", "items": items})
}
func (h *Handler) Update(c *gin.Context) {
	roleID, err := uuid.Parse(c.Param("id"))
	if err != nil {
		response.BadRequest(c, "Invalid role id")
		return
	}

	var req UpdateRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		response.BadRequest(c, "Invalid role payload")
		return
	}

	role, err := h.svc.Update(tenancy.CompanyID(c), roleID, req)
	if err != nil {
		switch {
		case errors.Is(err, ErrRoleNotFound):
			response.NotFound(c, err.Error())
		case errors.Is(err, ErrRoleNameRequired), errors.Is(err, ErrRolePermissionInvalid):
			response.BadRequest(c, err.Error())
		case errors.Is(err, ErrRoleNameExists):
			response.Conflict(c, err.Error())
		default:
			response.Internal(c, "Failed to update role")
		}
		return
	}

	response.OK(c, role)
}
func (h *Handler) Delete(c *gin.Context) {
	roleID, err := uuid.Parse(c.Param("id"))
	if err != nil {
		response.BadRequest(c, "Invalid role id")
		return
	}

	if err := h.svc.Delete(tenancy.CompanyID(c), roleID); err != nil {
		switch {
		case errors.Is(err, ErrRoleNotFound):
			response.NotFound(c, err.Error())
		default:
			response.Internal(c, "Failed to delete role")
		}
		return
	}

	response.OK(c, gin.H{"id": c.Param("id"), "module": "roles", "status": "deleted"})
}
